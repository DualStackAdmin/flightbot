# ===== Məcburi =====
BOT_TOKEN=                      # @BotFather-dən
POSTGRES_PASSWORD=change-me     # yalnız docker compose üçün

# ===== Qiymət provayderi =====
# fake: token olmadan demo/inkişaf (deterministik saxta qiymətlər)
# travelpayouts: real data (token və marker lazımdır)
PROVIDER=fake
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=794979     # partnyor ID (marker): gəlir buradan gəlir; kabinetdə təsdiqləyin
PROVIDER_RPS=3                  # real limiti Travelpayouts sənədindən yoxlayıb təyin edin

# ===== Bot rejimi =====
BOT_MODE=polling                # polling (dev) | webhook (prod)
# webhook üçün:
WEBHOOK_BASE_URL=               # https://bot.example.com
WEBHOOK_SECRET=                 # A-Z a-z 0-9 _ - ; uzun təsadüfi sətir
DOMAIN=                         # caddy (webhook profili) üçün: bot.example.com

# ===== Telegram limitləri =====
TELEGRAM_GLOBAL_RPS=25          # rəsmi ~30; 5 msg/s canlı cavablar üçün ehtiyat
TELEGRAM_USER_RPS=1

# ===== Digər =====
ENV=prod
LOG_LEVEL=INFO
SENTRY_DSN=
DEFAULT_LANGUAGE=az
DEFAULT_HOME_IATA=GYD

# Lokal (docker olmadan) işlətmək üçün:
# DATABASE_URL=postgresql+asyncpg://flightbot:flightbot@localhost:5432/flightbot
# REDIS_URL=redis://localhost:6379/0
