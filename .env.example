# ===== Required =====
BOT_TOKEN=                      # from @BotFather
POSTGRES_PASSWORD=change-me     # docker compose only; install.sh generates a random one
REDIS_PASSWORD=change-me        # docker compose only; install.sh generates a random one

# ===== Price provider =====
# fake: demo/development without a token (deterministic fake prices)
# travelpayouts: real data (token and marker required)
PROVIDER=fake
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=794979     # partner ID (marker): affiliate revenue is attributed here; confirm it in your dashboard
PROVIDER_RPS=3                  # verify the real limit in the Travelpayouts docs and set it

# ===== Bot mode =====
BOT_MODE=polling                # polling (dev) | webhook (prod)
# for webhook mode:
WEBHOOK_BASE_URL=               # https://bot.example.com
WEBHOOK_SECRET=                 # A-Z a-z 0-9 _ - ; a long random string
DOMAIN=                         # for caddy (webhook profile): bot.example.com
TUNNEL_TOKEN=                   # for cloudflared (tunnel profile): from the Cloudflare dashboard, see docs/CLOUDFLARE.md

# ===== Telegram limits =====
TELEGRAM_GLOBAL_RPS=25          # official ~30; keep 5 msg/s of headroom for live replies
TELEGRAM_USER_RPS=1

# ===== Other =====
ENV=prod
LOG_LEVEL=INFO
SENTRY_DSN=
DEFAULT_LANGUAGE=az             # fallback bot language: az | ru | en (the user's Telegram language wins when supported)
DEFAULT_HOME_IATA=GYD           # default origin airport/city for new users
# QUIET_START_HOUR=23           # quiet hours (notifications held until the window ends); equal values disable it
# QUIET_END_HOUR=8
# QUIET_TZ=Asia/Baku

# To run locally (without docker):
# DATABASE_URL=postgresql+asyncpg://flightbot:flightbot@localhost:5432/flightbot
# REDIS_URL=redis://localhost:6379/0
